---
// 애드센스 광고 단위. 게시자 ID 와 슬롯 ID 가 설정되어 있을 때만 출력됩니다.
// 개발 모드에서는 광고 위치를 확인할 수 있도록 자리 표시자를 보여줍니다.
import { SITE, type AdSlotName } from '../config/site';

interface Props {
  slot: AdSlotName;
  label: string;
}

const { slot, label } = Astro.props;
const client = SITE.adsense.client;
const slotId = SITE.adsense.slots[slot];
const enabled = Boolean(client && slotId);
---

{
  enabled ? (
    <aside class="ad-slot" aria-label={label}>
      <span class="ad-label">{label}</span>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={client}
        data-ad-slot={slotId}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script is:inline>
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </aside>
  ) : (
    import.meta.env.DEV && (
      <aside class="ad-slot ad-placeholder" aria-hidden="true">
        <span class="ad-label">{label}</span>
        <span>AdSense · {slot}</span>
      </aside>
    )
  )
}
