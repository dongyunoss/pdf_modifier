---
import { SITE } from '../config/site';
import { getDictionary, langPrefix, LANGS, LANGUAGES, switchLangPath, toolPath, type Lang } from '../i18n';
import { CATEGORY_ORDER, TOOLS } from '../tools/registry';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const dict = getDictionary(lang);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={langPrefix(lang)} aria-label={`${SITE.name} ${dict.nav.home}`}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="28" height="28"><rect width="32" height="32" rx="8" fill="currentColor"></rect><path d="M10 8h8l5 5v11a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2V10a2 2 0 0 1 2-2z" fill="#fff"></path><path d="M18 8v5h5" fill="none" stroke="currentColor" stroke-width="1.6"></path><path d="M11.5 18.5h9M11.5 21.5h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
      </span>
      <span class="brand-name">{SITE.name}</span>
    </a>

    <nav class="header-nav" aria-label={dict.nav.allTools}>
      <details class="menu">
        <summary class="btn btn-ghost">
          {dict.nav.allTools}
          <svg class="menu-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </summary>
        <div class="menu-panel">
          {
            CATEGORY_ORDER.map((category) => (
              <div class="menu-group">
                <p class="menu-group-title">{dict.categories[category]}</p>
                {TOOLS.filter((tool) => tool.category === category).map((tool) => (
                  <a class="menu-link" href={toolPath(lang, tool.id)} data-category={tool.category}>
                    <Icon name={tool.id} size={18} />
                    {dict.tools[tool.id].name}
                  </a>
                ))}
              </div>
            ))
          }
        </div>
      </details>

      <details class="menu lang-menu">
        <summary class="btn btn-ghost" aria-label={`${dict.nav.language}: ${LANGUAGES[lang].name}`}>
          <Icon name="globe" size={18} />
          <span class="lang-menu-current">{LANGUAGES[lang].name}</span>
          <svg class="menu-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </summary>
        <ul class="menu-panel lang-panel">
          {
            LANGS.map((code) => (
              <li>
                <a
                  href={switchLangPath(path, code)}
                  hreflang={LANGUAGES[code].htmlLang}
                  lang={LANGUAGES[code].htmlLang}
                  data-lang-choice={code}
                  class:list={['menu-link', 'lang-option', { 'is-active': code === lang }]}
                  aria-current={code === lang ? 'true' : undefined}
                >
                  {LANGUAGES[code].name}
                  {code === lang && <Icon name="check" size={16} />}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </nav>
  </div>
</header>

<script>
  import { LANG_STORAGE_KEY } from '../i18n/languages';

  // 메뉴 바깥을 클릭하거나 Esc 를 누르면 열린 메뉴(도구·언어)를 닫고, 한 메뉴를 열면 다른 메뉴는 닫습니다.
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('.site-header details.menu')];
  for (const menu of menus) {
    menu.addEventListener('toggle', () => {
      if (menu.open) menus.filter((other) => other !== menu).forEach((other) => (other.open = false));
    });
  }
  document.addEventListener('click', (event) => {
    for (const menu of menus) if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = menus.find((menu) => menu.open);
    if (!open) return;
    open.open = false;
    open.querySelector('summary')?.focus();
  });

  // 언어 메뉴(머리말·바닥글)에서 고른 언어를 기억해 두면, 다음에 다른 언어 주소로 들어와도 그 언어로 보여 줍니다.
  document.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[data-lang-choice]');
    if (!link?.dataset.langChoice) return;
    try {
      localStorage.setItem(LANG_STORAGE_KEY, link.dataset.langChoice);
    } catch {
      // 저장소를 쓸 수 없는 환경(사생활 보호 모드 등)에서는 기억하지 않습니다.
    }
  });
</script>
