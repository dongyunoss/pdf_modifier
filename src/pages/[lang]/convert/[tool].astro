---
import { PREFIXED_LANGS, type Lang } from '../../../i18n';
import { OFFICE_TOOLS, TOOLS, type OfficeToolId } from '../../../tools/registry';
import OfficeConvertView from '../../../views/OfficeConvertView.astro';

export function getStaticPaths() {
  return PREFIXED_LANGS.flatMap((lang) =>
    TOOLS.filter((tool) => tool.id in OFFICE_TOOLS).map((tool) => ({
      params: { lang, tool: tool.slug },
      props: { id: tool.id as OfficeToolId },
    })),
  );
}

const lang = Astro.params.lang as Lang;
const { id } = Astro.props;
---

<OfficeConvertView lang={lang} id={id} />
