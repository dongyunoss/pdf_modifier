---
import { getDictionary, LANGUAGES, pagePath, type Lang, type StaticPage } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalPage from './legal/LegalPage.astro';

interface Props {
  lang: Lang;
  page: StaticPage;
}

const { lang, page } = Astro.props;
const dict = getDictionary(lang);
/** 개인정보처리방침/이용약관 시행일 — 내용을 바꾸면 함께 수정하세요. (월은 0부터) */
const EFFECTIVE_DATE = Date.UTC(2026, 8, 29);
const effectiveDate = new Intl.DateTimeFormat(LANGUAGES[lang].locale, { dateStyle: 'long', timeZone: 'UTC' }).format(
  EFFECTIVE_DATE,
);

const titles: Record<StaticPage, string> = {
  about: dict.nav.about,
  privacy: dict.nav.privacy,
  terms: dict.nav.terms,
};
const descriptions: Record<StaticPage, string> = {
  about: dict.site.description,
  privacy: `${dict.nav.privacy} - ${dict.footer.privacyNote}`,
  terms: `${dict.nav.terms} - ${dict.site.tagline}`,
};
---

<BaseLayout lang={lang} title={titles[page]} description={descriptions[page]} path={pagePath(lang, page)}>
  <article class="container prose">
    <h1>{titles[page]}</h1>
    <LegalPage lang={lang} page={page} effectiveDate={effectiveDate} />
  </article>
</BaseLayout>
