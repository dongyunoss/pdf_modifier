# 복사해서 .env 로 저장하거나, Cloudflare Pages 대시보드의
# Settings → Variables and Secrets(빌드 환경변수)에 동일한 이름으로 입력하세요.
# 값이 비어 있으면 해당 기능(광고, 분석 등)은 자동으로 꺼집니다.

# ── 사이트 기본 정보 ─────────────────────────────────────────────
# 배포할 실제 도메인 (canonical URL, sitemap, OG 태그에 사용). 끝에 / 없이 입력
PUBLIC_SITE_URL=https://pdfmodifier.app
# 사이트 이름 (헤더, 제목 태그 등에 표시)
PUBLIC_SITE_NAME=PDF Modifier
# 문의 이메일 (소개/개인정보처리방침 페이지에 표시, 애드센스 심사에 도움)
PUBLIC_CONTACT_EMAIL=

# ── 수익화: Google AdSense ───────────────────────────────────────
# 게시자 ID (예: ca-pub-1234567890123456). 설정 시 ads.txt 도 자동 생성됩니다.
PUBLIC_ADSENSE_CLIENT=
# 광고 단위(슬롯) ID. 애드센스 → 광고 → 광고 단위 기준에서 '디스플레이 광고'를 만들어 입력하세요.
# 비워 두면 해당 위치에는 광고가 표시되지 않습니다. (자동 광고는 애드센스 대시보드에서 켜고 끕니다)
# 도구 바로 아래
PUBLIC_ADSENSE_SLOT_TOOL=
# 작업 완료(다운로드) 화면
PUBLIC_ADSENSE_SLOT_RESULT=
# 사용 방법과 FAQ 사이, 홈 화면
PUBLIC_ADSENSE_SLOT_CONTENT=

# ── 선택: 후원 링크 (예: https://www.buymeacoffee.com/yourname, 토스 후원 링크 등) ──
PUBLIC_DONATION_URL=

# ── 분석 (둘 다 무료) ────────────────────────────────────────────
# Cloudflare Web Analytics 토큰 (쿠키 없음, 권장)
PUBLIC_CF_ANALYTICS_TOKEN=
# Google Analytics 4 측정 ID (예: G-XXXXXXXXXX)
PUBLIC_GA_ID=

# ── 검색엔진 소유 확인 메타 태그 값 ────────────────────────────────
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_NAVER_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
